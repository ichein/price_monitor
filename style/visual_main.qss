* {
    font-family: "Segoe UI", "Arial", sans-serif;
}
QWidget {
    background-color: __BG__;
    color: __TEXTO__;
}
QMainWindow { background-color: __BG__; }

QTabWidget::pane {
    border: 3px solid __BORDE__;
    background: __SUPERFICIE__;
    top: -1px;
}
QTabBar::tab {
    background: __SUPERFICIE__;
    color: __TEXTO__;
    border: 3px solid __BORDE__;
    border-bottom: none;
    padding: 8px 18px;
    margin-right: 4px;
    font-weight: 700;
}
QTabBar::tab:selected {
    background: __ACENTO__;
    color: __SUPERFICIE__;
}

QPushButton {
    background-color: __ACENTO__;
    color: __SUPERFICIE__;
    border: 3px solid __BORDE__;
    padding: 8px 16px;
    font-weight: 700;
    border-radius: 4px;
}
QPushButton:hover { background-color: __ACENTO_HOVER__; }
QPushButton:pressed { background-color: __TEXTO__; color: __ACENTO__; }
QPushButton:disabled { background-color: __BORDE__; color: __TEXTO_SEC__; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background: __SUPERFICIE__;
    color: __TEXTO__;
    border: 2px solid __BORDE__;
    padding: 4px;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: __BORDE__;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: __ACENTO__;
    border: 2px solid __BORDE__;
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::sub-page:horizontal { background: __ACENTO__; border-radius: 3px; }

QTableWidget, QTreeWidget, QListWidget {
    background: __SUPERFICIE__;
    color: __TEXTO__;
    border: 3px solid __BORDE__;
    gridline-color: __BORDE__;
}
QHeaderView::section {
    background: __TEXTO__;
    color: __SUPERFICIE__;
    border: 1px solid __BORDE__;
    padding: 4px;
    font-weight: 700;
}
QGroupBox {
    border: 3px solid __BORDE__;
    margin-top: 14px;
    font-weight: 700;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    background: __ACENTO__;
    color: __SUPERFICIE__;
    border: 2px solid __BORDE__;
    border-radius: 3px;
}
QLabel#alerta {
    background: #FF5C5C;
    color: #1F2A24;
    border: 2px solid __BORDE__;
    padding: 6px;
    font-weight: 700;
}
QLabel#alerta_ok {
    background: __EXITO__;
    color: __SUPERFICIE__;
    border: 2px solid __BORDE__;
    padding: 6px;
    font-weight: 700;
}
QCheckBox { font-weight: 700; }
QLabel#texto_secundario { color: __TEXTO_SEC__; }